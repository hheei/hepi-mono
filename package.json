{
	"name": "hepi-mono",
	"version": "0.1.1",
	"private": true,
	"description": "Monorepo for HEPI Pi Coding Agent extensions.",
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"scripts": {
		"build": "pnpm --filter @hheei/pi-ext-core run build && pnpm --filter @hheei/pi-auto-title --filter @hheei/pi-btw --filter @hheei/pi-dollar-skill --filter @hheei/pi-ext-addon --filter @hheei/pi-ext-tools --filter @hheei/pi-settings --filter @hheei/pi-status --filter @hheei/pi-t2s run build",
		"check": "biome check . && pnpm run typecheck && pnpm test",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"test": "pnpm --filter @hheei/pi-ext-tools run build:native && vitest run",
		"bun:compat": "bun scripts/bun-compat-smoke.ts",
		"typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
		"tui:replay": "node --no-warnings --import jiti/register packages/pi-debug/src/tui-replay.ts",
		"tui:replay:session": "node --no-warnings --import jiti/register packages/pi-debug/src/tui-replay-session.ts",
		"publish:packages": "node scripts/publish-packages.mjs",
		"publish:dry-run": "node scripts/publish-packages.mjs --dry-run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@types/node": "^22.19.19",
		"jiti": "2.7.0",
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.5",
		"typebox": "1.3.7",
		"typescript": "^5.7.0",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22.19.0",
		"pnpm": ">=12.4.1"
	}
}
