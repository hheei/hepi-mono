{
	"name": "hepi-mono",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for HEPI Pi Coding Agent extensions.",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "biome check . && tsc --noEmit -p tsconfig.base.json && bun test",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"test": "bun test",
		"typecheck": "tsc --noEmit -p tsconfig.base.json",
		"new:extension": "bun scripts/create-extension.mjs",
		"pi:dev": "bun scripts/pi-dev.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@earendil-works/pi-ai": "latest",
		"@earendil-works/pi-coding-agent": "latest",
		"@earendil-works/pi-tui": "latest",
		"@types/bun": "latest",
		"@types/node": "^22.19.19",
		"typebox": "^1.1.38",
		"typescript": "^5.7.0"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
