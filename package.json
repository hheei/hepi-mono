{
	"name": "hepi-mono",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for HEPI Pi Coding Agent extensions.",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*",
		"!packages/hepi-subagents"
	],
	"scripts": {
		"check": "bun run build:aggregates && biome check . && tsc --noEmit -p tsconfig.typecheck.json && bun test --path-ignore-patterns='**/references/**'",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"build:aggregates": "bun scripts/build-aggregate.mjs --all",
		"test": "bun run build:aggregates && bun test --path-ignore-patterns='**/references/**' --path-ignore-patterns='packages/hepi-subagents/**'",
		"typecheck": "bun run build:aggregates && tsc --noEmit -p tsconfig.typecheck.json",
		"tui:replay": "bun packages/hepi-debug/src/tui-replay.ts",
		"tui:replay:session": "bun packages/hepi-debug/src/tui-replay-session.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@earendil-works/pi-agent-core": ">=0.83.0",
		"@earendil-works/pi-ai": ">=0.83.0",
		"@earendil-works/pi-coding-agent": ">=0.83.0",
		"@earendil-works/pi-tui": ">=0.83.0",
		"@types/bun": "latest",
		"@types/node": "^22.19.19",
		"typebox": "1.3.7",
		"typescript": "^5.7.0"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
