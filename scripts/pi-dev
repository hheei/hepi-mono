#!/usr/bin/env bun
import {
	existsSync,
	mkdirSync,
	readdirSync,
	readFileSync,
	writeFileSync,
} from "node:fs";
import { createHash } from "node:crypto";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const packageRoot = path.join(root, "packages");
const toolsPackageDir = path.join(packageRoot, "pi-ext-tools");
const nativeBridgePath = path.join(toolsPackageDir, "native", "pi-ext-tools-bridge.node");
const buildCacheDir = path.join(root, ".pi-dev");
const piCli = path.join(root, "node_modules", "@earendil-works", "pi-coding-agent", "dist", "cli.js");
const requiredBuildDirectories = [
	path.join(packageRoot, "pi-ext-core"),
	path.join(packageRoot, "pi-ext-embed"),
].filter(existsSync);

if (!existsSync(piCli)) {
	console.error("Missing local Pi. Run bun install from the repository root.");
	process.exit(1);
}

const packageDirsForPrefix = (prefix: string): string[] =>
	readdirSync(packageRoot, { withFileTypes: true })
		.filter((entry) => entry.isDirectory() && entry.name.startsWith(prefix))
		.map((entry) => path.join(packageRoot, entry.name))
		.filter((directory) => {
			const manifestPath = path.join(directory, "package.json");
			if (!existsSync(manifestPath)) return false;
			const manifest: unknown = JSON.parse(readFileSync(manifestPath, "utf8"));
			return (
				typeof manifest === "object" &&
				manifest !== null &&
				"pi" in manifest &&
				"name" in manifest &&
				typeof manifest.name === "string" &&
				manifest.name.startsWith("@hheei/")
			);
		})
		.sort();

const independentPackageDirs = packageDirsForPrefix("pi-");
const selectedPackageNames = new Set(
	(process.env.PI_DEV_PACKAGES ?? "")
		.split(",")
		.map((name) => name.trim())
		.filter((name) => name.length > 0),
);

function extensionPaths(directory: string): string[] {
	const manifest: unknown = JSON.parse(
		readFileSync(path.join(directory, "package.json"), "utf8"),
	);
	if (typeof manifest !== "object" || manifest === null || !("pi" in manifest)) return [];
	const pi = manifest.pi;
	if (typeof pi !== "object" || pi === null || !("extensions" in pi)) return [];
	const extensions = pi.extensions;
	if (!Array.isArray(extensions)) return [];
	return extensions.filter((extension): extension is string => typeof extension === "string").map((extension) =>
		path.join(directory, extension),
	);
}
const packageDirs = independentPackageDirs.filter((directory) =>
	selectedPackageNames.size > 0
		? selectedPackageNames.has(path.basename(directory))
		: true,
);

function updateSourceHash(hash: ReturnType<typeof createHash>, directory: string): void {
	for (const entry of readdirSync(directory, { withFileTypes: true }).sort((a, b) =>
		a.name.localeCompare(b.name),
	)) {
		const filePath = path.join(directory, entry.name);
		if (entry.isDirectory()) {
			updateSourceHash(hash, filePath);
		} else if (entry.isFile() && filePath.endsWith(".ts")) {
			hash.update(filePath);
			hash.update(readFileSync(filePath));
		}
	}
}

/** Hashes every Cargo input while excluding compiler outputs. */
function updateRustSourceHash(hash: ReturnType<typeof createHash>, directory: string): void {
	for (const entry of readdirSync(directory, { withFileTypes: true }).sort((a, b) =>
		a.name.localeCompare(b.name),
	)) {
		if (entry.name === "target") continue;
		const filePath = path.join(directory, entry.name);
		if (entry.isDirectory()) {
			updateRustSourceHash(hash, filePath);
		} else if (
			entry.isFile() &&
			(entry.name === "Cargo.toml" || entry.name === "Cargo.lock" || entry.name === "build.rs" || entry.name.endsWith(".rs"))
		) {
			hash.update(filePath);
			hash.update(readFileSync(filePath));
		}
	}
}

function buildFingerprint(directories: readonly string[]): string {
	const hash = createHash("sha256");
	for (const filePath of [path.join(root, "bun.lock"), path.join(root, "tsconfig.base.json")]) {
		hash.update(filePath);
		hash.update(readFileSync(filePath));
	}
	for (const directory of directories) {
		for (const fileName of ["package.json", "tsconfig.json", "tsconfig.build.json"]) {
			const filePath = path.join(directory, fileName);
			if (!existsSync(filePath)) continue;
			hash.update(filePath);
			hash.update(readFileSync(filePath));
		}
		const sourceDir = path.join(directory, "src");
		if (existsSync(sourceDir)) updateSourceHash(hash, sourceDir);
	}
	return hash.digest("hex");
}

function nativeBuildFingerprint(): string {
	const hash = createHash("sha256");
	for (const filePath of [
		path.join(root, "bun.lock"),
		path.join(toolsPackageDir, "package.json"),
		path.join(root, "scripts", "build-rust.mjs"),
	]) {
		hash.update(filePath);
		hash.update(readFileSync(filePath));
	}
	updateRustSourceHash(hash, path.join(root, "crates"));
	return hash.digest("hex");
}

mkdirSync(buildCacheDir, { recursive: true });
const buildStatePath = path.join(buildCacheDir, "build.json");
const buildDirectories = [...new Set([...requiredBuildDirectories, ...packageDirs])];
const typescriptFingerprint = buildFingerprint(buildDirectories);
const buildsNativeBridge = packageDirs.includes(toolsPackageDir);
const nativeFingerprint = buildsNativeBridge ? nativeBuildFingerprint() : undefined;
let cachedTypeScriptFingerprint: string | undefined;
let cachedNativeFingerprint: string | undefined;
try {
	const cached: unknown = JSON.parse(readFileSync(buildStatePath, "utf8"));
	if (
		typeof cached === "object" &&
		cached !== null &&
		"typescriptFingerprint" in cached &&
		typeof cached.typescriptFingerprint === "string"
	) {
		cachedTypeScriptFingerprint = cached.typescriptFingerprint;
	}
	if (
		typeof cached === "object" &&
		cached !== null &&
		"nativeFingerprint" in cached &&
		typeof cached.nativeFingerprint === "string"
	) {
		cachedNativeFingerprint = cached.nativeFingerprint;
	}
} catch {
	// No cached build state requires a fresh build.
}

const needsNativeBuild =
	nativeFingerprint !== undefined &&
	(nativeFingerprint !== cachedNativeFingerprint || !existsSync(nativeBridgePath));
const needsTypeScriptBuild =
	cachedTypeScriptFingerprint !== typescriptFingerprint ||
	buildDirectories.some((directory) => !existsSync(path.join(directory, "dist")));

if (needsNativeBuild) {
	const result = spawnSync(process.execPath, ["run", "build:native"], {
		cwd: toolsPackageDir,
		stdio: "inherit",
	});
	if (result.status !== 0) process.exit(result.status ?? 1);
}

if (needsTypeScriptBuild) {
	for (const directory of buildDirectories) {
		const result = spawnSync(process.execPath, ["run", "build", "--", "--noEmit", "false"], {
			cwd: directory,
			stdio: "inherit",
		});
		if (result.status !== 0) process.exit(result.status ?? 1);
	}
}

if (needsNativeBuild || needsTypeScriptBuild) {
	writeFileSync(
		buildStatePath,
		`${JSON.stringify({
			typescriptFingerprint,
			...(nativeFingerprint === undefined
				? cachedNativeFingerprint === undefined
					? {}
					: { nativeFingerprint: cachedNativeFingerprint }
				: { nativeFingerprint }),
		})}\n`,
	);
}

const extensionArgs = packageDirs.flatMap((directory) =>
	extensionPaths(directory).flatMap((extension) => ["--extension", extension]),
);
const childEnv = { ...process.env };
delete childEnv.OPENAI_API_KEY;
const result = spawnSync(
	process.execPath,
	[piCli, "--no-approve", "--no-extensions", ...extensionArgs, ...process.argv.slice(2)],
	{
	cwd: process.cwd(),
	env: childEnv,
	stdio: "inherit",
});
process.exit(result.status ?? 1);
