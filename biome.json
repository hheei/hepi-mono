{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"*.json",
			"*.md",
			"packages/*/**/*.ts",
			"packages/*/**/*.json",
			"scripts/**/*.mjs",
			"scripts/**/*.ts",
			"templates/**/*.ts",
			"templates/**/*.json",
			"test/**/*.ts",
			"!third_party",
			"!**/node_modules",
			"!**/dist",
			"!**/.pi",
			"!legacy",
			"!graphify-out"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"domains": {
			"types": "all"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "warn"
			},
			"style": {
				"noEnum": "error",
				"noNamespace": "error",
				"noNonNullAssertion": "error",
				"useConst": "warn"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noTsIgnore": "error",
				"noUnnecessaryConditions": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/*/test/**/*.ts", "packages/*/**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
