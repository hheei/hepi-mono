{
	"$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"*.json",
			"*.md",
			"packages/*/**/*.ts",
			"packages/*/**/*.json",
			"scripts/**/*.mjs",
			"scripts/**/*.ts",

			"!!**/dist",
			"!!**/.pi",
			"!references",
			"!legacy",
			"!!graphify-out"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"domains": {
			"types": "recommended"
		},
		"rules": {
			"preset": "recommended",

			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "warn",
				"noUnusedPrivateClassMembers": "warn",
				"noInvalidUseBeforeDeclaration": "error"
			},

			"suspicious": {
				"noControlCharactersInRegex": "off",
				"noExplicitAny": "error",
				"noTsIgnore": "error",
				"noFallthroughSwitchClause": "error",
				"noDoubleEquals": "error",
				"noVar": "error"
			},

			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error"
			},

			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": {
						"maxAllowedComplexity": 100
					}
				},
				"noForEach": "off",
				"noUselessTernary": "warn",
				"noUselessConstructor": "warn"
			},

			"style": {
				"noNonNullAssertion": "error",
				"useConst": "warn",
				"noParameterAssign": "off",
				"noEnum": "warn",
				"noNamespace": "warn"
			},

			"performance": {
				"noAccumulatingSpread": "error",
				"noDelete": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/*/test/**/*.ts",
				"packages/*/tests/**/*.ts",
				"packages/*/**/*.test.ts",
				"packages/*/**/*.spec.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					},
					"suspicious": {
						"noExplicitAny": "warn"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
