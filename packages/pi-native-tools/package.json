{
	"name": "@hheei/pi-native-tools",
	"version": "0.0.0",
	"description": "N-API access to selected vendored oh-my-pi native primitives.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"native",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"build:native": "bun ../../scripts/build-native.mjs",
