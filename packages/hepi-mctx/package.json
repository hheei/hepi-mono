{
	"name": "@hheei/hepi-mctx",
	"version": "0.0.0",
	"description": "HEPI Magic Context group for Pi.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"THIRD_PARTY_NOTICES.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"dist/extension.js"
		]
	},
	"scripts": {
		"build": "bun ../../scripts/build-aggregate.mjs hepi-mctx",
		"prepack": "bun run build"
