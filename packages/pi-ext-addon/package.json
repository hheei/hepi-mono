{
  "name": "@hheei/pi-ext-addon",
  "version": "0.0.0",
  "description": "Pi host addons for local assistant selection and future host integrations.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "dist/extension.js"
    ]
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "hepi",
    "addon"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hheei/hepi-mono.git",
    "directory": "packages/pi-ext-addon"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hheei/pi-ext-core": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@earendil-works/pi-tui": ">=0.83.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@types/bun": "latest"
  }
}
