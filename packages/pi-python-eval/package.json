{
	"name": "@hheei/pi-python-eval",
	"version": "0.6.0",
	"description": "Persistent session-scoped Python eval for Pi, with nested tool calls through the Pi host.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"dist/extension.js"
		]
	},
	"scripts": {
		"build": "node -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"import { cpSync } from 'node:fs'; cpSync('src/kernel/child.py', 'dist/kernel/child.py')\"",
		"prepack": "pnpm run build"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"python",
		"eval"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/pi-mono.git",
		"directory": "packages/pi-python-eval"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hheei/pi-ext-core": "workspace:^"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=1.2.0",
		"@earendil-works/pi-coding-agent": ">=1.2.0",
		"@earendil-works/pi-tui": ">=1.2.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^1.4.0",
		"@earendil-works/pi-ai": "^1.4.0",
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@earendil-works/pi-tui": "^1.4.0"
	}
}
