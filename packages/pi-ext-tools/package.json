{
	"name": "@hheei/pi-ext-tools",
	"version": "0.0.0",
	"description": "Canonical Pi replacements for core coding tools.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"bin",
		"native",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md",
		"UPSTREAM.md"
	],
	"pi": {
		"extensions": [
			"dist/extension.js"
		]
	},
	"scripts": {
		"build:native": "bun ../../scripts/build-native.mjs",
		"build": "bunx tsc -p tsconfig.build.json",
		"prepack": "bun run build"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"hepi",
		"tools"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/pi-ext-tools"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@ff-labs/fff-node": "^0.9.6",
		"@hheei/pi-ext-core": "workspace:*",
		"better-result": "^2.10.0",
		"typebox": "1.3.7"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.83.0",
		"@earendil-works/pi-ai": ">=0.83.0",
		"@earendil-works/pi-coding-agent": ">=0.83.0",
		"@earendil-works/pi-tui": ">=0.83.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.83.0",
		"@napi-rs/cli": "^3.5.0",
		"@types/bun": "latest"
	}
}
