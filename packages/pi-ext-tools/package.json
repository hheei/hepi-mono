{
	"name": "@hheei/pi-ext-tools",
	"version": "0.0.0",
	"description": "Canonical Pi replacements for core coding tools.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"native",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md",
		"UPSTREAM.md"
	],
	"pi": {
		"extensions": [
			"dist/extension.js"
		]
	},
	"scripts": {
		"build:native": "node ../../scripts/build-rust.mjs",
		"test:native": "pnpm run build:native && vitest run ./test/native-shell.native.ts",
		"build": "tsc -p tsconfig.build.json && node -e \"import { cpSync } from 'node:fs'; cpSync('src/eval/kernel/child.py', 'dist/eval/kernel/child.py')\"",
		"prepack": "pnpm run build"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"hepi",
		"tools"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/pi-ext-tools"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@ff-labs/fff-node": "^0.10.3",
		"@hheei/pi-ext-core": "workspace:0.0.0",
		"acorn": "^8.18.0",
		"better-result": "^2.10.0",
		"cli-highlight": "^2.1.11",
		"diff": "^9.0.0",
		"typebox": "1.3.7"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.85.1",
		"@earendil-works/pi-ai": ">=0.85.1",
		"@earendil-works/pi-coding-agent": ">=0.85.1",
		"@earendil-works/pi-tui": ">=0.85.1"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "0.85.1",
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@napi-rs/cli": "^3.5.0"
	}
}
