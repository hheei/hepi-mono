{
	"name": "@hheei/pi-web-access",
	"version": "0.1.0",
	"description": "Web search, URL fetching, GitHub repo extraction, and content tools for Pi.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"dist/extension.js"
		]
	},
	"scripts": {
		"build": "node -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"hepi",
		"web-search",
		"tools"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/pi-web-access"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hheei/pi-ext-core": "workspace:^",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@mozilla/readability": "^0.6.0",
		"defuddle": "0.19.3",
		"linkedom": "^0.16.0",
		"p-limit": "^6.1.0",
		"turndown": "^7.2.0",
		"undici": "^8.11.2",
		"unpdf": "^1.6.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=1.3.0",
		"@earendil-works/pi-ai": ">=1.3.0",
		"@earendil-works/pi-coding-agent": ">=1.3.0",
		"@earendil-works/pi-tui": ">=1.3.0",
		"typebox": "^1.3.27"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0",
		"@types/turndown": "^5.0.6"
	}
}
