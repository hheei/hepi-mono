{
	"name": "@hheei/hepi-mono",
	"version": "0.0.0",
	"description": "Unified HEPI extension loader for Pi.",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/extension.ts"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"hepi"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/hepi-mono"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hheei/hepi-basics": "workspace:*",
		"@hheei/hepi-skills": "workspace:*",
		"@hheei/hepi-tools": "workspace:*",
		"@hheei/pi-btw": "workspace:*",
		"@hheei/pi-plan": "workspace:*"
	},
	"bundledDependencies": [
		"@hheei/hepi-basics",
		"@hheei/hepi-skills",
		"@hheei/hepi-tools",
		"@hheei/pi-btw",
		"@hheei/pi-plan"
	],
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.82.0",
		"@types/bun": "latest"
	}
}
