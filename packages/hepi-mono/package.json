{
	"name": "@hheei/hepi-mono",
	"version": "0.0.0",
	"description": "Unified HEPI extension loader for Pi.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"dist/extension.js"
		]
	},
	"scripts": {
		"build": "bun ../../scripts/build-aggregate.mjs hepi-mono",
		"prepack": "bun run build"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"hepi"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/hepi-mono"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@ff-labs/fff-bun": "^0.10.1",
		"@ff-labs/fff-node": "^0.9.6",
		"ffi-rs": "^1.3.2"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.82.0",
		"@hheei/hepi-aft": "workspace:*",
		"@types/bun": "latest"
	}
}
