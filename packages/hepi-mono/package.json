{
	"name": "@hheei/hepi-mono",
	"version": "0.1.3",
	"description": "Unified HEPI extension loader for Pi.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/extension.js"
		],
		"themes": [
			"./dist/themes"
		],
		"skills": [
			"./dist/skills"
		]
	},
	"scripts": {
		"build": "bun ../../scripts/build-package.mjs hepi-mono",
		"prepack": "bun run build"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"hepi"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/hepi-mono"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@cortexkit/aft-bridge": "0.49.0",
		"@ff-labs/fff-bun": "^0.10.1",
		"@ff-labs/fff-node": "^0.10.1",
		"ffi-rs": "^1.3.2"
	},
	"optionalDependencies": {
		"@cortexkit/aft-darwin-arm64": "0.49.0",
		"@cortexkit/aft-darwin-x64": "0.49.0",
		"@cortexkit/aft-linux-arm64": "0.49.0",
		"@cortexkit/aft-linux-x64": "0.49.0",
		"@cortexkit/aft-win32-arm64": "0.49.0",
		"@cortexkit/aft-win32-x64": "0.49.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@hheei/hepi-aft": "workspace:*",
		"@types/bun": "latest"
	}
}
