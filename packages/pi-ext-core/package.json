{
	"name": "@hheei/pi-ext-core",
	"version": "0.3.0",
	"description": "Shared lifecycle and coordination primitives for independent Pi extensions.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./errors": "./dist/errors.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"hepi",
		"extension-core"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/pi-ext-core"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"proper-lockfile": "4.1.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=1.0.0",
		"@earendil-works/pi-ai": ">=1.0.0",
		"@earendil-works/pi-coding-agent": ">=1.0.0",
		"@earendil-works/pi-tui": ">=1.0.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "1.1.0",
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@earendil-works/pi-tui": "1.1.0",
		"@types/proper-lockfile": "4.1.4"
	}
}
