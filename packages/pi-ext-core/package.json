{
	"name": "@hheei/pi-ext-core",
	"version": "0.2.0",
	"description": "Shared lifecycle and coordination primitives for independent Pi extensions.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./errors": "./dist/errors.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"hepi",
		"extension-core"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/pi-ext-core"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"proper-lockfile": "4.1.2",
		"typebox": "1.3.27"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.87.0",
		"@earendil-works/pi-ai": ">=0.87.0",
		"@earendil-works/pi-coding-agent": ">=0.87.0",
		"@earendil-works/pi-tui": ">=0.87.0"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "0.87.1",
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1",
		"@types/proper-lockfile": "4.1.4"
	}
}
