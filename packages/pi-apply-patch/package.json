{
	"name": "@hheei/pi-apply-patch",
	"version": "0.3.2",
	"description": "V4A apply_patch editing tool with worker matching and per-path publishing.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"pi": {
		"extensions": [
			"dist/extension.js"
		]
	},
	"scripts": {
		"build": "node -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"tools"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/pi-mono.git",
		"directory": "packages/pi-apply-patch"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hheei/pi-ext-core": "workspace:^",
		"diff": "^9.0.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=1.0.1",
		"@earendil-works/pi-coding-agent": ">=1.0.1",
		"@earendil-works/pi-tui": ">=1.0.1",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^1.4.0",
		"@earendil-works/pi-ai": "^1.4.0",
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@earendil-works/pi-tui": "^1.4.0"
	}
}
