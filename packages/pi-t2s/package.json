{
	"name": "@hheei/pi-t2s",
	"version": "0.0.0",
	"description": "Traditional-to-Simplified Chinese input conversion for Pi.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"dist/extension.js"
		]
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "npm run build"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"hepi",
		"traditional-chinese",
		"simplified-chinese"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/pi-t2s"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hheei/pi-ext-core": "0.0.0",
		"opencc-js": "^1.4.0",
		"typebox": "1.3.7"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.84.1",
		"@earendil-works/pi-ai": ">=0.84.1",
		"@earendil-works/pi-coding-agent": ">=0.84.1",
		"@earendil-works/pi-tui": ">=0.84.1"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1"
	}
}
