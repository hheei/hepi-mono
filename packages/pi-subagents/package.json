{
	"name": "@hheei/pi-subagents",
	"version": "0.1.2",
	"description": "Independent background Pi subagent sessions with durable identity and RPC control.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"dist/extension.js"
		]
	},
	"scripts": {
		"prepack": "pnpm run build",
		"build": "node -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"hepi",
		"subagents"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/pi-subagents"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hheei/pi-ext-core": "workspace:^0.1.1",
		"typebox": "1.3.7"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.87.0",
		"@earendil-works/pi-tui": ">=0.87.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1"
	}
}
