{
	"name": "@hheei/pi-subagents",
	"version": "0.0.0",
	"description": "Core-backed autonomous sub-agents for Pi.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/hheei/hepi-mono.git",
		"directory": "packages/pi-subagents"
	},
	"homepage": "https://github.com/hheei/hepi-mono",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"subagent",
		"agent",
		"autonomous"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.83.0",
		"@earendil-works/pi-ai": ">=0.83.0",
		"@earendil-works/pi-coding-agent": ">=0.83.0",
		"@earendil-works/pi-tui": ">=0.83.0"
	},
	"dependencies": {
		"@hheei/pi-ext-core": "workspace:*",
		"croner": "^10.0.1",
		"nanoid": "^5.0.0",
		"typebox": "1.3.7"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepublishOnly": "bun run lint && bun run typecheck && bun run test && bun run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run e2e --reporter=verbose",
		"typecheck": "bunx tsc --noEmit",
		"lint": "bunx biome check src/ test/",
		"lint:fix": "bunx biome check --write src/ test/"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.83.0",
		"@biomejs/biome": "^2.4.14",
		"@types/bun": "latest",
		"@types/node": "^25.5.0",
		"typescript": "^6.0.0",
		"vitest": "^4.0.18"
	},
	"pi": {
		"extensions": [
			"dist/index.js"
		],
		"video": "https://github.com/tintinweb/pi-subagents/raw/master/media/demo.mp4",
		"image": "https://github.com/tintinweb/pi-subagents/raw/master/media/screenshot.png"
	}
}
