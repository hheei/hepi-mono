{
	"name": "@hheei/pi-debug",
	"version": "0.0.0",
	"description": "Development diagnostics and TUI replay tools for Pi extensions.",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./tui-replay": "./src/tui-replay.ts"
	},
	"bin": {
		"pi-tui-replay": "src/tui-replay.ts",
		"replay": "src/tui-replay-session.ts"
	},
	"files": [
		"src",
		"README.md",
		"CACHE_DEBUG.md",
		"TUI_REPLAY.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/extension.ts"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"prompt-cache",
		"tui",
		"replay",
		"debug"
	],
	"license": "MIT",
	"dependencies": {
		"@hheei/pi-ext-core": "workspace:*",
		"proper-lockfile": "4.1.2"
	},
	"devDependencies": {
		"@types/proper-lockfile": "4.1.4"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.84.0",
		"@earendil-works/pi-ai": ">=0.84.0",
		"@earendil-works/pi-coding-agent": ">=0.84.0",
		"@earendil-works/pi-tui": ">=0.84.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/pi-debug"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
