{
	"name": "@hheei/pi-bg-bash",
	"version": "0.3.3",
	"description": "Background Bash tools with durable execution records and report delivery.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"dist/extension.js"
		]
	},
	"scripts": {
		"build": "node -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"hepi",
		"background-bash",
		"tools"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/pi-bg-bash"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hheei/pi-ext-core": "workspace:^"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=1.3.0",
		"@earendil-works/pi-coding-agent": ">=1.3.0",
		"@earendil-works/pi-tui": ">=1.3.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0"
	}
}
