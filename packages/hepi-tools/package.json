{
	"name": "@hheei/hepi-tools",
	"version": "0.0.0",
	"description": "HEPI tool and agent group for Pi.",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/extension.ts"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"hepi",
		"tools"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hheei/hepi-mono.git",
		"directory": "packages/hepi-tools"
	},
	"publishConfig": {
		"access": "public"
	},
	"bundledDependencies": [
		"@hheei/pi-advisor",
		"@hheei/pi-ask",
		"@hheei/pi-codex-tool",
		"@hheei/pi-goal",
		"@hheei/pi-sshfs",
		"@hheei/pi-todo",
		"@cortexkit/pi-magic-context",
		"pi-fff",
		"pi-web-access"
	],
	"dependencies": {
		"@hheei/pi-advisor": "workspace:*",
		"@hheei/pi-ask": "workspace:*",
		"@hheei/pi-codex-tool": "workspace:*",
		"@hheei/pi-goal": "workspace:*",
		"@hheei/pi-sshfs": "workspace:*",
		"@hheei/pi-todo": "workspace:*",
		"@cortexkit/pi-magic-context": "^0.33.0",
		"pi-fff": "^0.1.12",
		"pi-web-access": "^0.14.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.82.0",
		"@earendil-works/pi-ai": ">=0.82.0",
		"@earendil-works/pi-coding-agent": ">=0.82.0",
		"@earendil-works/pi-tui": "*",
		"@hheei/pi-basics": ">=0.0.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.82.0",
		"@types/bun": "latest",
		"@hheei/pi-basics": "workspace:*"
