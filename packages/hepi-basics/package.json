{
	"name": "@hheei/hepi-basics",
	"version": "0.0.0",
	"description": "HEPI foundational runtime group for Pi.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
