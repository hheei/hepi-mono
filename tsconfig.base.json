{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"@hheei/pi-magic-context": ["packages/hepi-mctx/src/pi-magic-context.d.ts"],
			"pi-fff": ["packages/hepi-tools/src/pi-fff.d.ts"],
			"pi-web-access": ["packages/hepi-tools/src/pi-web-access.d.ts"]
		},
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"types": ["node", "bun"]
	},
	"include": ["packages/*/**/*.ts", "test/**/*.ts"],
	"exclude": ["third_party/**", "**/node_modules/**", "**/dist/**", "**/.pi/**"]
}
